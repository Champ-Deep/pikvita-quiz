# Environment Configuration Template
# Copy this file to .env and update with your actual values

# Environment
NODE_ENV=production

# API Configuration
QUIZ_API_ENDPOINT=https://api.pikvita.com/api/quiz-responses
QUIZ_API_STAGING=https://staging-api.pikvita.com/api/quiz-responses
QUIZ_EMBED_URL=https://quiz.pikvita.com/embed
QUIZ_CDN_URL=https://cdn.pikvita.com/quiz

# Database Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/pikvita-quiz
MONGODB_DB_NAME=pikvita-quiz

# Email Service - SendGrid (recommended)
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=hello@pikvita.com
EMAIL_FROM_NAME=Pikvita Team
EMAIL_REPLY_TO=hello@pikvita.com

# Email Service - Mailgun (alternative)
# EMAIL_PROVIDER=mailgun
# MAILGUN_API_KEY=key-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# MAILGUN_DOMAIN=pikvita.com

# Email Service - AWS SES (alternative)
# EMAIL_PROVIDER=ses
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxxxxx
# AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Waitlist Integration
WAITLIST_PROVIDER=custom
WAITLIST_API_ENDPOINT=https://api.pikvita.com/waitlist

# Waitlist - Mailchimp (alternative)
# WAITLIST_PROVIDER=mailchimp
# MAILCHIMP_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-us1
# MAILCHIMP_LIST_ID=xxxxxxxxxx
# MAILCHIMP_SERVER=us1

# Waitlist - ConvertKit (alternative)
# WAITLIST_PROVIDER=convertkit
# CONVERTKIT_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# CONVERTKIT_FORM_ID=xxxxxxxx

# Analytics
GA_ENABLED=true
GA_MEASUREMENT_ID=G-XXXXXXXXXX
FB_PIXEL_ENABLED=true
FB_PIXEL_ID=xxxxxxxxxxxxxxx
ANALYTICS_ENDPOINT=https://analytics.pikvita.com/events

# Security
API_KEY=your-secret-api-key-here-change-in-production
CORS_ORIGINS=https://pikvita.com,https://www.pikvita.com,https://app.pikvita.com

# Feature Flags
FEATURE_EMAIL=true
FEATURE_WAITLIST=true
FEATURE_ANALYTICS=true
FEATURE_SHARING=true

# URLs
WEBSITE_URL=https://pikvita.com
WAITLIST_URL=https://pikvita.com/waitlist
PRIVACY_URL=https://pikvita.com/privacy
TERMS_URL=https://pikvita.com/terms
